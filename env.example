# Copy to ~/.claude/token-glance/env (chmod 600). Never commit the real file.

# Long-lived Claude Code token from `claude setup-token`. Stored in Secret Manager
# as `claude-token`; kept here only so you can re-create that secret.
CLAUDE_TOKEN=

# Shared secret between watch, scheduler and relay. 26 chars of [a-z2-7]:
#   LC_ALL=C tr -dc 'a-z2-7' </dev/urandom | head -c 26; echo
TOKEN=

# Filled in after the first deploy, e.g. https://usage-relay-xxxx-ez.a.run.app
RELAY_URL=

# Your GCP account, project and the relay's runtime service account.
GCP_ACCOUNT=you@example.com
GCP_PROJECT=
GCP_SERVICE_ACCOUNT=usage-relay@<project>.iam.gserviceaccount.com
